# Copy to .op-receipts.env (gitignored by the .op-*.env rule) and keep one line per
# mail account. These are 1Password REFERENCES, not secrets — op run resolves
# them into the subprocess so no value ever reaches argv, stdout or a shell.
#
# Item names follow COBALT_DINGO_GMAIL_APP_PASSWORD_<ACCOUNT>, in the HomeLab
# vault. HomeLab rather than AgentSecrets because a Gmail App Password is minted
# by a human in a Google account — its creation is governed by Mathias, and
# AgentSecrets is for keys the agent generates.
#
# All references must resolve from ONE vault: a mixed-vault env-file fails
# wholesale and takes the resolvable references down with it.

GMAIL_APP_PASSWORD_MATHIAS_BERGQVIST=op://HomeLab/COBALT_DINGO_GMAIL_APP_PASSWORD_MATHIAS_BERGQVIST/password
GMAIL_APP_PASSWORD_MTHBQV=op://HomeLab/COBALT_DINGO_GMAIL_APP_PASSWORD_MTHBQV/password
GMAIL_APP_PASSWORD_DMABE=op://HomeLab/COBALT_DINGO_GMAIL_APP_PASSWORD_DMABE/password
