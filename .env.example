# Kopiera den här filen till .env och fyll i dina värden
# .env committas ALDRIG – den finns i .gitignore

FORTNOX_CLIENT_ID=din_client_id_här
FORTNOX_CLIENT_SECRET=din_client_secret_här
FORTNOX_REDIRECT_URI=http://localhost:8080/callback

# sandbox | production
FORTNOX_ENV=sandbox

# Scopes att begära – kommaseparerade.
# Måste matcha exakt vad som är aktiverat på din app i Fortnox developer-portalen.
# 'assets' är odokumenterat men fungerar för anläggningsregistret.
FORTNOX_SCOPES=bookkeeping,invoice,supplierinvoice,customer,supplier,payment,inbox,assets

# Sökvägar
AUDIT_LOG_PATH=~/.coo-agent/audit.log
TOKEN_PATH=~/.coo-agent/tokens.enc
