package templates

templ Keys(keys []APIKey, newKey *CreatedKey) {
	@Layout("API-nycklar") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-xl font-semibold">API-nycklar</h1>
			<button
				hx-get="/ui/keys/new"
				hx-target="#key-form"
				hx-swap="innerHTML"
				class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
			>
				Skapa ny nyckel
			</button>
		</div>
		<div id="key-form" class="mb-6"></div>
		if newKey != nil {
			<div class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4">
				<p class="text-sm font-medium text-green-800 mb-2">
					✓ Nyckel skapad – kopiera den nu, den visas aldrig igen.
				</p>
				<code class="block rounded bg-white border border-green-200 px-3 py-2 text-sm font-mono text-gray-900 select-all">
					{ newKey.Plaintext }
				</code>
			</div>
		}
		<div class="rounded-lg border bg-white overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Etikett</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Skapad</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Senast använd</th>
						<th class="px-4 py-3"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100" id="key-list">
					for _, k := range keys {
						@KeyRow(k)
					}
					if len(keys) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-6 text-center text-sm text-gray-400">
								Inga nycklar skapade än.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ KeyRow(k APIKey) {
	<tr id={ "key-" + k.ID }>
		<td class="px-4 py-3 text-sm text-gray-900">{ k.Label }</td>
		<td class="px-4 py-3 text-sm text-gray-500">{ k.CreatedAt.Format("2006-01-02") }</td>
		<td class="px-4 py-3 text-sm text-gray-500">
			if k.LastUsedAt != nil {
				{ k.LastUsedAt.Format("2006-01-02 15:04") }
			} else {
				<span class="text-gray-300">Aldrig</span>
			}
		</td>
		<td class="px-4 py-3 text-right">
			<button
				hx-delete={ "/ui/keys/" + k.ID }
				hx-target={ "#key-" + k.ID }
				hx-swap="outerHTML"
				hx-confirm={ "Återkalla nyckeln \"" + k.Label + "\"? Alla klienter som använder den slutar fungera." }
				class="text-sm text-red-500 hover:text-red-700"
			>
				Återkalla
			</button>
		</td>
	</tr>
}

templ KeyForm() {
	<form
		hx-post="/ui/keys"
		hx-target="#key-list"
		hx-swap="beforeend"
		class="flex gap-3 items-end rounded-lg border bg-white p-4 mb-2"
	>
		<div class="flex-1">
			<label class="block text-sm font-medium text-gray-700 mb-1">Etikett</label>
			<input
				type="text"
				name="label"
				required
				placeholder="t.ex. Claude Code – flamingo"
				class="block w-full rounded border-gray-300 shadow-sm text-sm px-3 py-2 border focus:ring-blue-500 focus:border-blue-500"
			/>
		</div>
		<button
			type="submit"
			class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
		>
			Skapa
		</button>
	</form>
}
